{
  "expo": {
    "name": "ApnaUstad",
    "slug": "ApnaUstad",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/679e09c9-47e0-41e5-9ca3-a60026d0a9df"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "apnaustad",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apnaustad.app",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow ApnaUstad to use your location to connect you with nearby Ustads and show arrival times.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow ApnaUstad to track service location for real-time arrival and job updates.",
        "NSPhotoLibraryUsageDescription": "Allow ApnaUstad to access your photos to provide visual evidence for service requests.",
        "NSCameraUsageDescription": "Allow ApnaUstad to access your camera to capture service evidence.",
        "NSMicrophoneUsageDescription": "Allow ApnaUstad to access your microphone for recording service voice notes."
      }
    },
    "android": {
      "package": "com.apnaustad.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.jpeg"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth",
              "RNFBMessaging"
            ]
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0F172A"
        }
      ],
      "@react-native-google-signin/google-signin",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ApnaUstad to track service location for real-time arrival and job updates.",
          "locationWhenInUsePermission": "Allow ApnaUstad to use your location to connect you with nearby Ustads and show arrival times."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ApnaUstad to access your photos to provide visual evidence for service requests.",
          "cameraPermission": "Allow ApnaUstad to access your camera to capture service evidence."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-audio",
      "expo-video",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://api.apnaustad.app",
      "maptilerApiKey": "o3cm0oM4Yn3L4Nyf1ydh",
      "router": {},
      "eas": {
        "projectId": "679e09c9-47e0-41e5-9ca3-a60026d0a9df"
      }
    }
  }
}
